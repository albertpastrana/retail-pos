# Copy to /etc/alloy/env and replace every value. Keep this file mode 0600.

GRAFANA_CLOUD_API_TOKEN=replace-with-a-grafana-cloud-api-token
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-us-central1.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USERNAME=replace-with-prometheus-instance-id
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-us-central1.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USERNAME=replace-with-loki-user-id
GRAFANA_CLOUD_OTLP_USERNAME=replace-with-otlp-user-id
GRAFANA_CLOUD_OTLP_ENDPOINT=otlp-gateway-prod-us-central1.grafana.net:443

# PostgreSQL on the application host. URL-encode special characters in the password.
POSTGRES_MONITOR_DSN=postgresql://grafana_monitor:replace-with-monitor-password@127.0.0.1:5432/pos?sslmode=disable
