	<field name="UNITS" class="java.lang.Double"/>
	<field name="LASTSALE" class="java.util.Date"/>
	<variable name="REPORTUNITS" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{UNITS}]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0.0)]]></initialValueExpression>
	</variable>
	<background><band/></background>
	<title>
		<band height="45">
			<rectangle radius="5"><reportElement mode="Opaque" x="0" y="0" width="535" height="36" forecolor="#000000" backcolor="#409617"/></rectangle>
			<textField><reportElement x="13" y="7" width="510" height="28" forecolor="#FFFFFF"/><textElement><font fontName="Dialog" size="18" isBold="true"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$R{label.slowstock}]]></textFieldExpression></textField>
		</band>
	</title>
	<pageHeader><band/></pageHeader>
	<columnHeader>
		<band height="22">
			<textField><reportElement x="0" y="0" width="85" height="20"/><textElement><font isBold="true"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$R{label.location}]]></textFieldExpression></textField>
			<textField><reportElement x="90" y="0" width="85" height="20"/><textElement><font isBold="true"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$R{label.reference}]]></textFieldExpression></textField>
			<textField><reportElement x="180" y="0" width="220" height="20"/><textElement><font isBold="true"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$R{label.name}]]></textFieldExpression></textField>
			<textField><reportElement x="405" y="0" width="45" height="20"/><textElement textAlignment="Right"><font isBold="true"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$R{label.units}]]></textFieldExpression></textField>
			<textField><reportElement x="455" y="0" width="80" height="20"/><textElement textAlignment="Right"><font isBold="true"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$R{label.lastsale}]]></textFieldExpression></textField>
		</band>
	</columnHeader>
	<detail>
		<band height="20">
			<textField isBlankWhenNull="true"><reportElement x="0" y="0" width="85" height="18"/><textFieldExpression class="java.lang.String"><![CDATA[$F{LOCATIONNAME}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="90" y="0" width="85" height="18"/><textFieldExpression class="java.lang.String"><![CDATA[$F{REFERENCE}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="180" y="0" width="220" height="18"/><textFieldExpression class="java.lang.String"><![CDATA[$F{NAME}]]></textFieldExpression></textField>
			<textField><reportElement x="405" y="0" width="45" height="18"/><textElement textAlignment="Right"/><textFieldExpression class="java.lang.String"><![CDATA[com.openbravo.format.Formats.DOUBLE.formatValue($F{UNITS})]]></textFieldExpression></textField>
			<textField><reportElement x="455" y="0" width="80" height="18"/><textElement textAlignment="Right"/><textFieldExpression class="java.lang.String"><![CDATA[$F{LASTSALE} == null ? $R{label.neversold} : com.openbravo.format.Formats.DATE.formatValue($F{LASTSALE})]]></textFieldExpression></textField>
		</band>
	</detail>
	<columnFooter><band/></columnFooter>
