<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="stockbymodel" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<property name="ireport.encoding" value="UTF-8"/>
	<field name="LOCATIONID" class="java.lang.String"/>
	<field name="LOCATIONNAME" class="java.lang.String"/>
	<field name="REFERENCE" class="java.lang.String"/>
	<field name="NAME" class="java.lang.String"/>
	<field name="UNITS" class="java.lang.Double"/>
	<variable name="MODELUNITS" class="java.lang.Double" resetType="Group" resetGroup="MODEL" calculation="Sum">
		<variableExpression><![CDATA[$F{UNITS}]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0.0)]]></initialValueExpression>
	</variable>
	<variable name="REPORTUNITS" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{UNITS}]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0.0)]]></initialValueExpression>
	</variable>
	<group name="MODEL">
		<groupExpression><![CDATA[$F{LOCATIONID} + "|" + ($F{REFERENCE} == null ? "" : $F{REFERENCE}.replaceFirst("^((?:PU)?[0-9]+).*$", "$1"))]]></groupExpression>
		<groupHeader>
			<band height="25">
				<textField>
					<reportElement x="0" y="3" width="535" height="20"/>
					<textElement><font fontName="Dialog" size="13" isBold="true"/></textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{LOCATIONNAME} + " — " + $R{label.model} + ": " + ($F{REFERENCE} == null ? "" : $F{REFERENCE}.replaceFirst("^((?:PU)?[0-9]+).*$", "$1"))]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="25">
				<line><reportElement x="0" y="1" width="535" height="1"/></line>
				<textField><reportElement x="300" y="4" width="170" height="18"/><textElement textAlignment="Right"><font isBold="true"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$R{label.modeltotal}]]></textFieldExpression></textField>
				<textField><reportElement x="475" y="4" width="60" height="18"/><textElement textAlignment="Right"><font isBold="true"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[com.openbravo.format.Formats.DOUBLE.formatValue($V{MODELUNITS})]]></textFieldExpression></textField>
			</band>
		</groupFooter>
	</group>
	<background><band/></background>
	<title>
		<band height="45">
			<rectangle radius="5"><reportElement mode="Opaque" x="0" y="0" width="535" height="36" forecolor="#000000" backcolor="#409617"/></rectangle>
			<textField><reportElement x="13" y="7" width="510" height="28" forecolor="#FFFFFF"/><textElement><font fontName="Dialog" size="18" isBold="true"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$R{label.stockbymodel}]]></textFieldExpression></textField>
		</band>
	</title>
	<pageHeader><band/></pageHeader>
	<columnHeader>
		<band height="22">
			<textField><reportElement x="10" y="0" width="100" height="20"/><textElement><font isBold="true"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$R{label.reference}]]></textFieldExpression></textField>
			<textField><reportElement x="115" y="0" width="350" height="20"/><textElement><font isBold="true"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$R{label.name}]]></textFieldExpression></textField>
			<textField><reportElement x="475" y="0" width="60" height="20"/><textElement textAlignment="Right"><font isBold="true"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$R{label.units}]]></textFieldExpression></textField>
		</band>
	</columnHeader>
	<detail>
		<band height="20">
			<textField isBlankWhenNull="true"><reportElement x="10" y="0" width="100" height="18"/><textFieldExpression class="java.lang.String"><![CDATA[$F{REFERENCE}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="115" y="0" width="350" height="18"/><textFieldExpression class="java.lang.String"><![CDATA[$F{NAME}]]></textFieldExpression></textField>
			<textField><reportElement x="475" y="0" width="60" height="18"/><textElement textAlignment="Right"/><textFieldExpression class="java.lang.String"><![CDATA[com.openbravo.format.Formats.DOUBLE.formatValue($F{UNITS})]]></textFieldExpression></textField>
		</band>
	</detail>
	<columnFooter><band/></columnFooter>
	<pageFooter><band height="15"><textField><reportElement x="495" y="0" width="40" height="15"/><textElement textAlignment="Right"/><textFieldExpression class="java.lang.Integer"><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter>
	<summary>
		<band height="25">
			<textField><reportElement x="300" y="4" width="170" height="18"/><textElement textAlignment="Right"><font isBold="true"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$R{label.reporttotal}]]></textFieldExpression></textField>
			<textField><reportElement x="475" y="4" width="60" height="18"/><textElement textAlignment="Right"><font isBold="true"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[com.openbravo.format.Formats.DOUBLE.formatValue($V{REPORTUNITS})]]></textFieldExpression></textField>
		</band>
	</summary>
</jasperReport>
