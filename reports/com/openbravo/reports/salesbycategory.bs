report = new com.openbravo.pos.reports.PanelReportBean();

report.setTitleKey("Menu.SalesByCategory");
report.setReport("/com/openbravo/reports/salesbycategory");
report.setResourceBundle("com/openbravo/reports/modelreports_messages");

// Subcategory names are only unique among siblings, so a row needs the parent
// name to say which family "Màniga curta" belongs to. Products sitting straight
// in a root category report under their own name.
report.setSentence(
        "SELECT COALESCE(PARENTCAT.NAME, CATEGORIES.NAME) AS CATEGORYNAME, " +
        "CATEGORIES.NAME AS SUBCATEGORYNAME, " +
        "CATEGORIES.PARENTID AS PARENTID, " +
        "SUM(TICKETLINES.UNITS) AS UNITS, " +
        "SUM(TICKETLINES.UNITS * TICKETLINES.PRICE) AS TOTAL " +
        "FROM RECEIPTS " +
        "JOIN TICKETS ON RECEIPTS.ID = TICKETS.ID " +
        "JOIN TICKETLINES ON TICKETS.ID = TICKETLINES.TICKET " +
        "JOIN PRODUCTS ON TICKETLINES.PRODUCT = PRODUCTS.ID " +
        "JOIN CATEGORIES ON PRODUCTS.CATEGORY = CATEGORIES.ID " +
        "LEFT OUTER JOIN CATEGORIES PARENTCAT ON CATEGORIES.PARENTID = PARENTCAT.ID " +
        "WHERE ?(QBF_FILTER) " +
        "GROUP BY COALESCE(PARENTCAT.NAME, CATEGORIES.NAME), CATEGORIES.NAME, CATEGORIES.PARENTID " +
        "ORDER BY COALESCE(PARENTCAT.NAME, CATEGORIES.NAME), CATEGORIES.NAME");
report.addParameter("RECEIPTS.DATENEW");
report.addParameter("RECEIPTS.DATENEW");
report.addQBFFilter(new com.openbravo.pos.reports.JParamsDatesInterval());
report.addParameter("PRODUCTS.NAME");
report.addParameter("PRODUCTS.PRICEBUY");
report.addParameter("PRODUCTS.PRICESELL");
report.addParameter("PRODUCTS.CATEGORY");
report.addParameter("PRODUCTS.CODE");
report.addParameter("PRODUCTS.BRAND");
report.addQBFFilter(new com.openbravo.pos.ticket.ProductFilter());

report.addField("CATEGORYNAME", com.openbravo.data.loader.Datas.STRING);
report.addField("SUBCATEGORYNAME", com.openbravo.data.loader.Datas.STRING);
report.addField("PARENTID", com.openbravo.data.loader.Datas.STRING);
report.addField("UNITS", com.openbravo.data.loader.Datas.DOUBLE);
report.addField("TOTAL", com.openbravo.data.loader.Datas.DOUBLE);

report;
