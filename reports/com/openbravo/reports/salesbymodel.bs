report = new com.openbravo.pos.reports.PanelReportBean();

report.setTitleKey("Menu.SalesByModel");
report.setReport("/com/openbravo/reports/salesbymodel");
report.setResourceBundle("com/openbravo/reports/modelreports_messages");

report.setSentence(
        "SELECT PRODUCTS.REFERENCE, PRODUCTS.NAME, " +
        "SUM(TICKETLINES.UNITS) AS UNITS, " +
        "SUM(TICKETLINES.UNITS * TICKETLINES.PRICE) AS TOTAL " +
        "FROM RECEIPTS " +
        "JOIN TICKETS ON RECEIPTS.ID = TICKETS.ID " +
        "JOIN TICKETLINES ON TICKETS.ID = TICKETLINES.TICKET " +
        "JOIN PRODUCTS ON TICKETLINES.PRODUCT = PRODUCTS.ID " +
        "WHERE ?(QBF_FILTER) " +
        "GROUP BY PRODUCTS.REFERENCE, PRODUCTS.NAME " +
        "ORDER BY PRODUCTS.REFERENCE, PRODUCTS.NAME");
report.addParameter("RECEIPTS.DATENEW");
report.addParameter("RECEIPTS.DATENEW");
report.addQBFFilter(new com.openbravo.pos.reports.JParamsDatesInterval());
report.addParameter("PRODUCTS.NAME");
report.addParameter("PRODUCTS.PRICEBUY");
report.addParameter("PRODUCTS.PRICESELL");
report.addParameter("PRODUCTS.CATEGORY");
report.addParameter("PRODUCTS.CODE");
report.addParameter("PRODUCTS.BRAND");
report.addQBFFilter(new com.openbravo.pos.ticket.ProductFilter());

report.addField("REFERENCE", com.openbravo.data.loader.Datas.STRING);
report.addField("NAME", com.openbravo.data.loader.Datas.STRING);
report.addField("UNITS", com.openbravo.data.loader.Datas.DOUBLE);
report.addField("TOTAL", com.openbravo.data.loader.Datas.DOUBLE);

report;
