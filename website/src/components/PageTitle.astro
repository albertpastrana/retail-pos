---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isCatalan = Astro.url.pathname.includes('/docs/ca/');
---
<DefaultPageTitle {...Astro.props} />
<div class="doc-actions">
  <button type="button" onclick="window.print()">{isCatalan ? 'Imprimeix aquesta pàgina' : 'Print this page'}</button>
  <a href={`${base}/downloads/documentation-${isCatalan ? 'ca' : 'en'}.pdf`}>{isCatalan ? 'Descarrega la guia en PDF' : 'Download guide as PDF'}</a>
</div>
