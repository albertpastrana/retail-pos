<output>

    <display>
        <line>
            <text align="center" length="20">Tiquet regal</text>
        </line>
        <line>
           <text align="center" length="20">Gràcies.</text>
        </line>
    </display>

    <ticket>
        <image>Printer.Ticket.Logo</image>
        <line></line>
        <line>
            <text align="center" length="42">Born, 7 - Igualada</text>
        </line>
        <line>
            <text align="center" length="42">Tel. 938031974</text>
        </line>
        <line>
            <text align="center" length="42">NIF: 77097341F</text>
        </line>
        <line></line>
        <line>
            <text align="center" length="42" bold="true">Tiquet regal</text>
        </line>
        <line></line>
        <line>
            <text align="left" length="21">Rebut: ${ticket.printId()}</text>
            <text align="right" length="21">${ticket.printDateShort()}</text>
        </line>
        <line></line>
        <line>
            <text align ="left" length="38">Article</text>
            <text align ="right" length="4">#</text>
        </line>
        <line>
             <text>------------------------------------------</text>
        </line>

        #foreach ($ticketline in $ticket.getLines())
        <line>
             #if ($ticketline.isProductCom())
                 <text align ="left" length="38">*${ticketline.printTicketName()}</text>
             #else
                 <text align ="left" length="38">${ticketline.printTicketName()}</text>
             #end
            <text align ="right" length="4">${ticketline.printMultiply()}</text>
        </line>
        <line>
            <text align ="left" length="42">${ticketline.printTicketReference()}</text>
        </line>
        #end

        <line>
             <text>------------------------------------------</text>
        </line>
        <line>
            <text align="left" length="32">Número d'articles:</text>
            <text align="right" length="3">${ticket.printArticlesCount()}</text>
        </line>
        <line></line>
        <line>
            <text align="center" length="42">Gràcies per la seva visita</text>
        </line>
        <line>
            <text align="center" length="42">Té 20 dies per a efectuar canvis</text>
        </line>

    </ticket>

</output>
